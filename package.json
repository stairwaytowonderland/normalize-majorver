{
	"name": "normalize-majorver",
	"description": "Create, update, and normalize major version tags for GitHub Actions based on semantic versioning tags",
	"version": "1.8.0",
	"author": "stairwaytowonderland",
	"type": "module",
	"private": true,
	"homepage": "https://github.com/stairwaytowonderland/normalize-majorver",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stairwaytowonderland/normalize-majorver.git"
	},
	"bugs": {
		"url": "https://github.com/stairwaytowonderland/normalize-majorver/issues"
	},
	"keywords": [
		"actions"
	],
	"exports": {
		".": "./dist/index.js"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"format-check": "npm run check:format",
		"lint": "npm run check:lint",
		"build": "npm run compile",
		"test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --coverage",
		"bundle": "npm run check && npm run build && npm run package",
		"compile": "tsc",
		"package": "npx rimraf ./dist && npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
		"package:watch": "npm run package -- --watch",
		"clean": "rm -rf node_modules dist coverage",
		"clean-cache": "npm cache clean --force",
		"check": "npm run check:format && npm run check:lint && npm run check:type",
		"check:format": "prettier --check .",
		"check:lint": "eslint .",
		"check:build": "tsc --noEmit",
		"check:type": "tsc --noEmit --project tsconfig.test.json",
		"fix": "npm run fix:format && npm run fix:lint",
		"fix:format": "prettier --write . > /dev/null",
		"fix:lint": "eslint --fix .",
		"coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
		"docs": "rm -rf docs && npx typedoc --options typedoc.action.json",
		"local-action": "npx @github/local-action . src/main.ts .env",
		"package-lock:install": "npm install --package-lock-only --ignore-scripts",
		"package-lock:fix": "node -e \"const fs = require('fs'); const f = 'package-lock.json'; const c = fs.readFileSync(f, 'utf8').trimEnd(); fs.writeFileSync(f, c + '\\n');\"",
		"install:clean": "npm run clean && rm -f package-lock.json && npm run package-lock:install && npm install",
		"postinstall": "npm run package-lock:fix && printf '\\033[1;32m%s:\\033[0m\\033[0;32m %s\\033[0m\n' 'Installation complete' 'Run `npm run build` to build the project.'",
		"all": "npm run install:clean && npm run fix && npm run test && npm run coverage && npm run package && npm run docs"
	},
	"license": "MIT",
	"dependencies": {},
	"devDependencies": {
		"@actions/core": "^3.0.0",
		"@actions/github": "^9.1.1",
		"@emnapi/runtime": "^1.11.3",
		"@emnapi/wasi-threads": "^2.1.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@github/local-action": "^7.0.1",
		"@jest/globals": "^30.5.1",
		"@rollup/plugin-commonjs": "^29.0.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.5.0",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.62.1",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jest": "^29.16.6",
		"eslint-plugin-prettier": "^5.5.5",
		"jest": "^30.5.1",
		"make-coverage-badge": "^1.2.0",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"rollup": "^4.63.1",
		"rollup-plugin-license": "^3.7.1",
		"semantic-release": "^25.0.9",
		"semantic-release-export-data": "^1.2.0",
		"ts-jest": "^29.4.12",
		"ts-jest-resolver": "^2.0.1",
		"typedoc-plugin-coverage": "^4.0.3",
		"typedoc-plugin-markdown": "^4.13.1",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"undici": "^6.29.1"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "*"
	}
}
