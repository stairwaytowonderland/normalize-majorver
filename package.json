{
	"name": "normalize-majorver",
	"description": "Create, update, and normalize major version tags for GitHub Actions based on semantic versioning tags",
	"version": "1.3.0",
	"author": "stairwaytowonderland",
	"type": "module",
	"private": true,
	"homepage": "https://github.com/stairwaytowonderland/normalize-majorver",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stairwaytowonderland/normalize-majorver.git"
	},
	"bugs": {
		"url": "https://github.com/stairwaytowonderland/normalize-majorver/issues"
	},
	"keywords": [
		"actions"
	],
	"exports": {
		".": "./dist/index.js"
	},
	"engines": {
		"node": ">=24.0.0",
		"npm": ">= 8.0.0"
	},
	"scripts": {
		"clean": "rm -rf node_modules package-lock.json && rm -rf dist",
		"clean-cache": "npm cache clean --force",
		"install:safe": "npm install --legacy-peer-deps --node-gyp=./node_modules/.bin/node-gyp",
		"build": "npm run bundle",
		"bundle": "npm run format:write && npm run package",
		"ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
		"coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
		"format:write": "prettier --write .",
		"format:check": "prettier --check .",
		"format-write": "npm run format:write",
		"format-check": "npm run format:check",
		"lint": "eslint .",
		"local-action": "npx @github/local-action . src/main.ts .env",
		"package": "npx rimraf ./dist && npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
		"package:watch": "npm run package -- --watch",
		"test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest --coverage",
		"all": "npm run format:write && npm run lint && npm run test && npm run coverage && npm run package"
	},
	"license": "MIT",
	"dependencies": {},
	"devDependencies": {
		"@actions/core": "^3.0.0",
		"@actions/github": "^9.0.0",
		"@emnapi/runtime": "^1.11.3",
		"@emnapi/wasi-threads": "^2.0.1",
		"@eslint/compat": "^2.0.2",
		"@eslint/eslintrc": "^3.3.6",
		"@eslint/js": "^10.0.1",
		"@github/local-action": "^7.0.1",
		"@jest/globals": "^30.2.0",
		"@rollup/plugin-commonjs": "^29.0.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.1.2",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-github": "^6.0.0",
		"eslint-plugin-jest": "^29.16.0",
		"eslint-plugin-prettier": "^5.5.5",
		"globals": "^17.4.0",
		"jest": "^30.2.0",
		"prettier": "3.9.10",
		"rimraf": "^6.1.3",
		"rollup": "^4.62.5",
		"rollup-plugin-license": "^3.7.1",
		"semantic-release": "^25.0.6",
		"semantic-release-export-data": "^1.2.0",
		"ts-jest": "^29.4.12",
		"ts-jest-resolver": "^2.0.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0"
	},
	"overrides": {
		"undici": "^6.29.1"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "*"
	}
}
